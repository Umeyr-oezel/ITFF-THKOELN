# Vorlage fuer die lokale .env - echte Werte NIEMALS committen.
# .env steht in .gitignore.

# PostgreSQL-Verbindung (Django liest diese Werte in settings.py)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=group01
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password

# Lokaler SQLite-Fallback (kein Server, keine Zugangsdaten noetig).
# Zum lokalen Entwickeln/Testen die zwei DB_ENGINE/DB_NAME-Zeilen oben
# auskommentieren und stattdessen diese beiden aktivieren. DB_NAME ist
# dann ein Dateiname; die DB-Datei steht in .gitignore und landet nie
# auf GitHub.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=local.sqlite3

# Django internals (optional - defaults work for local dev and the test suite)
# DJANGO_SECRET_KEY=your-secret-key-here
# DJANGO_DEBUG=True

# Year range for the pipeline (default: 2020-2025)
START_YEAR=2020
END_YEAR=2025

# Pipeline behaviour (defaults work fine for most setups)
USER_AGENT=University Group01 group01@student.university.edu
REQUEST_DELAY=0.2
CREATED_BY=group01
MAX_RETRIES=3
MAX_REASONABLE_PRICE=1000000
BATCH_SIZE=5000
TOP_N=5
