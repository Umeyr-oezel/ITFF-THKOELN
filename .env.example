# Vorlage fuer die lokale .env - echte Werte NIEMALS committen.
# .env steht in .gitignore.

# ---------------------------------------------------------------------------
# OPTION A: Uni-Server (Plan A - Herr Miebs)
# ---------------------------------------------------------------------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=group01
# DB_HOST=<uni-server-host>
# DB_PORT=5432
# DB_USER=<uni-username>
# DB_PASSWORD=<uni-password>
# DB_SSLMODE=
# DB_CONN_HEALTH_CHECKS=False
# START_YEAR=2020
# END_YEAR=2025

# ---------------------------------------------------------------------------
# OPTION B1: Aiven Free Tier (Plan B - FAVORIT, Frankfurt)
# Konto anlegen: https://aiven.io  (kein Kreditkarte erforderlich)
# Nach Login: Services -> PostgreSQL -> New Free Service -> Region: Frankfurt
# Zugangsdaten unter "Connection information" -> "Service URI" ablesen
# ---------------------------------------------------------------------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=defaultdb
# DB_HOST=<projektname>.a.aivencloud.com
# DB_PORT=<port-aus-aiven-dashboard>
# DB_USER=avnadmin
# DB_PASSWORD=<passwort-aus-aiven-dashboard>
# DB_SSLMODE=require
# DB_CONN_HEALTH_CHECKS=False
# START_YEAR=2021
# END_YEAR=2025

# ---------------------------------------------------------------------------
# OPTION B2: Neon Free Tier (Plan B - RESERVE, Frankfurt)
# Konto anlegen: https://neon.tech  (kein Kreditkarte erforderlich)
# Nach Login: New Project -> Region: EU Frankfurt -> Connection String kopieren
# ---------------------------------------------------------------------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=neondb
# DB_HOST=<project-id>.eu-central-1.aws.neon.tech
# DB_PORT=5432
# DB_USER=<username-aus-neon-dashboard>
# DB_PASSWORD=<passwort-aus-neon-dashboard>
# DB_SSLMODE=require
# DB_CONN_HEALTH_CHECKS=True
# START_YEAR=2023
# END_YEAR=2025

# ---------------------------------------------------------------------------
# OPTION C: Lokaler SQLite-Fallback (Entwicklung & Tests, kein Server noetig)
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=local.sqlite3
DB_SSLMODE=
DB_CONN_HEALTH_CHECKS=False

# ---------------------------------------------------------------------------
# Django internals (optional - defaults funktionieren fuer lokale Entwicklung)
# ---------------------------------------------------------------------------
# DJANGO_SECRET_KEY=your-secret-key-here
# DJANGO_DEBUG=True

# ---------------------------------------------------------------------------
# Zeitraum der Pipeline (default: 2020-2025)
# Fuer Aiven empfohlen: START_YEAR=2021 (5 Jahre, ~730 MB von 1 GB)
# Fuer Neon empfohlen:  START_YEAR=2023 (3 Jahre, ~438 MB von 512 MB)
# ---------------------------------------------------------------------------
START_YEAR=2020
END_YEAR=2025

# ---------------------------------------------------------------------------
# Pipeline-Verhalten (defaults passen fuer die meisten Setups)
# ---------------------------------------------------------------------------
USER_AGENT=University Group01 group01@student.university.edu
REQUEST_DELAY=0.2
CREATED_BY=group01
MAX_RETRIES=3
MAX_REASONABLE_PRICE=1000000
BATCH_SIZE=5000
TOP_N=5
